# Public browser configuration only. RLS protects access; these values are bundled into the app.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SILVERSTONE_API_URL=

# Rust API configuration. Keep provider keys on the API host, never in VITE_ variables.
# SILVERSTONE_LISTEN_ADDR=127.0.0.1:8787  # Optional; leave unset when the host supplies PORT.
SILVERSTONE_ALLOWED_ORIGINS=https://silverstoneb.vercel.app,http://localhost:5173
SILVERSTONE_SUPABASE_URL=https://your-project-ref.supabase.co
SILVERSTONE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
